---
const groups = [
  ['HR', 'Закупки и логистика', 'Продажи и развитие', 'Строительство', 'Управление продуктами/проектами/процессами'],
  ['Административный персонал', 'Безопасность и охрана труда', 'Работа в IT', 'Технический блок', 'Контроль качества, аудит и комплаенс'],
  ['Аналитика', 'Маркетинг и PR', 'Стажировки', 'Финансы'],
  ['Дизайн', 'Поддержка клиентов', 'Стратегия и развитие', 'Юриспруденция'],
];
---
<footer class="relative z-10 bg-white px-5 pb-6 md:px-8">
  <div class="mx-auto max-w-[1480px] rounded-[40px] bg-mist px-6 pb-8 pt-8 text-ink-deep md:px-[88px] md:pt-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div class="max-w-[600px]">
        <p class="font-text text-[20px] font-medium tracking-[-0.02em]">МТС – лидер технологий*</p>
        <p class="mt-3 font-text text-[16px] leading-[1.5] md:text-[18px]">Мы развиваем телеком, цифровые и финансовые сервисы для тех, кто не хочет зависеть от обстоятельств и стремится действовать умнее в новых условиях.</p>
        <p class="mt-5 font-text text-[12px] leading-[1.3] text-[#8d969f]">*Лидер технологий — согласно сравнительному анализу технологического развития операторов связи, проведённому ООО «Джейсон энд Партнерс Консалтинг» 01.10.25 г. Подробнее – на json.tv</p>
        <a href="#" class="mt-7 inline-flex h-11 items-center rounded-xl bg-ink-deep px-5 font-text text-[16px] text-white transition-transform hover:-translate-y-0.5">Смотреть вакансии</a>
      </div>
      <div class="flex gap-4 text-[#8d969f]">
        <a href="#" aria-label="Telegram" class="flex size-11 items-center justify-center rounded-full bg-[#d5d9de] text-white transition-colors hover:bg-ink-deep">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M9.04 15.47 8.7 20.1c.5 0 .7-.2.96-.47l2.3-2.2 4.77 3.5c.87.48 1.5.23 1.72-.8l3.12-14.6c.28-1.27-.46-1.77-1.31-1.45L1.9 11.1c-1.24.48-1.22 1.17-.21 1.48l4.66 1.45L17.2 7.2c.5-.33.96-.15.58.18"/></svg>
        </a>
        <a href="#" aria-label="VK" class="flex size-11 items-center justify-center rounded-full bg-[#d5d9de] text-white transition-colors hover:bg-ink-deep">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12.8 17.5c-5.9 0-9.3-4-9.4-10.8h3c.1 5 2.3 7.1 4 7.5V6.7h2.8v4.3c1.7-.2 3.5-2.1 4.1-4.3h2.8c-.5 2.7-2.4 4.6-3.8 5.4 1.4.7 3.6 2.4 4.4 5.4h-3.1c-.6-2-2.2-3.6-4.4-3.8v3.8h-.4Z"/></svg>
        </a>
      </div>
    </div>

    <nav class="mt-10 grid gap-x-8 gap-y-4 font-text text-[16px] text-[#626c77] md:grid-cols-4 md:text-[17px]" aria-label="Направления работы">
      {groups.map((g) => (
        <ul class="space-y-4">
          {g.map((item) => <li><a href="#" class="transition-colors hover:text-ink-deep">{item}</a></li>)}
        </ul>
      ))}
    </nav>

    <div class="mt-10 flex flex-col gap-3 border-t border-black/5 pt-6 font-text text-[13px] text-[#8d969f] md:flex-row md:items-center md:justify-between">
      <p>© 2026 ПАО «МТС». Все права защищены</p>
      <a href="#" class="hover:text-ink-deep">Политика «Обработка персональных данных» в ПАО «МТС».</a>
      <p>18+</p>
    </div>
  </div>
  <button type="button" data-scroll-top class="fixed bottom-6 right-6 z-30 flex size-11 items-center justify-center rounded-full bg-white text-ink-deep opacity-0 shadow-[0_4px_16px_rgba(0,0,0,0.12)] transition-opacity data-[show]:opacity-100" aria-label="Наверх">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M6 15l6-6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</footer>
