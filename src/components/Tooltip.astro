---
/**
 * Плашка с выноской. Позиция — в координатах макета (data-x/data-y), расставляет Overlay.resize().
 * Линия рисуется SVG в направлении `side`, на конце — точка с кольцом.
 */
import type { Tooltip } from '../lib/content';
interface Props { tip: Tooltip; fin: number; fout: number; style?: 'glass' | 'solid' }
const { tip, fin, fout, style = 'glass' } = Astro.props;
const horizontal = tip.side === 'left' || tip.side === 'right';
const L = tip.len;
// SVG для выноски: линия длиной L и точка на конце
const svgW = horizontal ? L + 12 : 20;
const svgH = horizontal ? 20 : L + 12;
const x2 = horizontal ? (tip.side === 'right' ? L : 12) : 10;
const x1 = horizontal ? (tip.side === 'right' ? 0 : L + 12) : 10;
const y1 = horizontal ? 10 : (tip.side === 'bottom' ? 0 : L + 12);
const y2 = horizontal ? 10 : (tip.side === 'bottom' ? L : 12);
---
<div
  class:list={['tip', `tip--${tip.side}`, `tip--${style}`]}
  data-x={tip.x} data-y={tip.y}
  data-in={fin + (tip.delay ?? 0)} data-out={fout} data-dir="scale"
>
  <div class="tip__box" style={`width: calc(${tip.w}px * var(--rs, 1));`}>
    <p class="tip__title" set:html={tip.title.replace('\n', '<br/>')} />
    <p class="tip__text">{tip.text}</p>
  </div>
  <svg class="tip__line" width={svgW} height={svgH} viewBox={`0 0 ${svgW} ${svgH}`} aria-hidden="true">
    <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="currentColor" stroke-width="0.8" class="tip__stroke" />
    <circle cx={x2} cy={y2} r="2.7" fill="currentColor" />
    <circle cx={x2} cy={y2} r="5.6" stroke="currentColor" stroke-width="0.8" fill="none" class="tip__ring" />
  </svg>
</div>

<style>
  .tip {
    position: absolute;
    display: flex; align-items: center;
    color: var(--color-cream);
    --p: calc(18.5px * var(--rs, 1));
    will-change: transform, opacity;
  }
  .tip--bottom, .tip--top { flex-direction: column; align-items: center; }
  .tip--top { flex-direction: column-reverse; }
  .tip--left { flex-direction: row-reverse; }
  .tip__box {
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid #fff;
    border-radius: calc(12.3px * var(--rs, 1));
    padding: var(--p);
    color: var(--color-ink);
    flex: none;
    backdrop-filter: blur(6px);
    box-shadow: 0 10px 30px -18px rgba(20, 20, 40, 0.35);
  }
  .tip--solid .tip__box { background: var(--color-cream); backdrop-filter: none; }
  .tip__title {
    font-family: var(--font-wide); font-weight: 700; text-transform: uppercase;
    font-size: calc(10.8px * var(--rs, 1)); line-height: 1.5; margin: 0 0 calc(3px * var(--rs, 1));
  }
  .tip__text { font-family: var(--font-text); font-size: calc(11px * var(--rs, 1)); line-height: 1.45; margin: 0; }
  .tip__line { flex: none; overflow: visible; }
  .tip--right .tip__line, .tip--left .tip__line { margin-inline: -1px; }
  .tip__ring { animation: ring 2.4s ease-out infinite; transform-origin: center; transform-box: fill-box; }
  @keyframes ring {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(1.9); opacity: 0; }
  }
  .tip__stroke { stroke-dasharray: 400; stroke-dashoffset: 0; }
  @media (max-width: 1023px) {
    .tip { display: none !important; }
  }
</style>
