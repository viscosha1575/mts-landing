---
/**
 * Сцена: липкий вьюпорт с WebGL-канвасом, канвас боке и DOM-оверлей.
 * Высоту секции задаёт app.ts исходя из веса кадров.
 */
import { locations } from '../lib/content';
import Tooltip from './Tooltip.astro';
---
<section id="experience" class="relative" aria-label="Технологии МТС: путешествие по локациям">
  <div class="sticky top-0 h-[100svh] overflow-hidden bg-cream">
    <canvas id="stage" class="absolute inset-0 block size-full"></canvas>
    <canvas id="fx" class="pointer-events-none absolute inset-0 block size-full opacity-0"></canvas>

    <div id="overlay" class="absolute inset-0 overflow-hidden">
      <!-- Волны у антенны (кадры 0–3) -->
      <div id="waves" class="waves pointer-events-none absolute left-0 top-0" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </div>

      <!-- Тросы аэростата (кадр 9) -->
      <svg id="tether" class="pointer-events-none absolute left-0 top-0 opacity-0" viewBox="0 0 853 220" preserveAspectRatio="none" aria-hidden="true">
        <g fill="none" stroke="#faf4f0" stroke-width="1.1" opacity="0.55" stroke-linecap="round">
          <path d="M214 0C216 70 250 140 318 205" />
          <path d="M232 0C240 72 285 138 342 207" />
          <path d="M226 0C214 80 232 150 300 213" />
        </g>
      </svg>

      <!-- Логотип на куртке / стене при зуме (кадры 27–29) -->
      <div id="logo-zoom" class="pointer-events-none absolute left-0 top-0 opacity-0" aria-hidden="true">
        <img src="/logo.svg" alt="" class="size-full" />
      </div>

      {locations.map((loc) => (
        <div class="loc" data-loc={loc.id}>
          <div
            class="loc__title"
            data-x="62" data-y={416 + (loc.offsetY ?? 0)} data-safe
            data-in={loc.index === 0 ? 0.25 : (loc.titleIn ?? loc.titleFrame - 0.45)} data-out={loc.titleFrame + 0.9} data-dir="up"
            data-theme={loc.theme}
          >
            <div class="loc__meta" data-reveal>
              <span class="loc__num">{loc.num}</span>
              <span class="pager" data-pager aria-hidden="true">
                {locations.map((_, i) => <i class:list={{ 'is-active': i === loc.index }}></i>)}
              </span>
            </div>
            <h2 class="loc__h" data-reveal style={`font-size: calc(${loc.titleSize}px * var(--ui, 1)); ${loc.titleWidth ? `width: calc(${loc.titleWidth}px * var(--ui, 1));` : ''}`}
              set:html={loc.title.replace('\n', '<br/>')} />
            <p class="loc__p" data-reveal style={`width: calc(${loc.textWidth}px * var(--ui, 1));`}>{loc.text}</p>
            <ul class="loc__chips" data-reveal aria-label="Факты">
              {loc.tooltips.map((tip) => <li>{tip.title.replace('\n', ' ')}</li>)}
            </ul>
          </div>
          {loc.tooltips.map((tip) => (
            <Tooltip tip={tip} fin={loc.titleIn !== undefined ? loc.titleIn + 0.05 : loc.titleFrame - 0.2} fout={loc.titleFrame + 0.85} style={loc.tooltipStyle} />
          ))}
        </div>
      ))}

    </div>

    <div id="debug" class="pointer-events-none absolute bottom-2 left-2 z-20 hidden font-mono text-[11px] text-white/60 mix-blend-difference" data-debug></div>
  </div>
</section>

<style>
  .loc__title {
    position: absolute;
    color: var(--color-ink); will-change: transform, opacity;
    max-width: calc(100vw - 40px);
  }
  .loc__title[data-theme='dark'] { color: #fff; }
  .loc__title[data-theme='dark']::after {
    content: ''; position: absolute; z-index: -1; left: -30%; top: -35%; width: 150%; height: 170%;
    background: radial-gradient(ellipse at 40% 50%, rgba(255,255,255,0.16), rgba(255,255,255,0) 60%);
    pointer-events: none;
  }
  .loc__meta { display: flex; align-items: center; gap: calc(20.8px * var(--ui, 1)); margin-bottom: calc(24.6px * var(--ui, 1)); }
  .loc__num { font-family: var(--font-wide); font-weight: 500; color: var(--color-red); font-size: calc(27.7px * var(--ui, 1)); line-height: 1; }
  .pager { display: inline-flex; gap: calc(18.5px * var(--ui, 1)); }
  .pager i { display: block; width: calc(9.2px * var(--ui, 1)); height: calc(9.2px * var(--ui, 1)); border-radius: 50%; background: var(--color-cream); transition: background 0.4s, transform 0.4s; }
  .pager i.is-active { background: var(--color-red); transform: scale(1.15); }
  .loc__h { font-family: var(--font-wide); font-weight: 500; line-height: 0.72; letter-spacing: -0.01em; margin: 0 0 calc(24.6px * var(--ui, 1)); white-space: nowrap; }
  .loc__h[style*='width'] { white-space: normal; line-height: 1; }
  .loc__p { font-family: var(--font-text); font-size: calc(18.5px * var(--ui, 1)); line-height: 1.12; margin: 0; }

  .waves { transform-origin: 0 0; opacity: 0; mix-blend-mode: overlay; }
  .waves span {
    position: absolute; inset: 0; border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.9);
    animation: wave 4.2s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
    opacity: 0;
    box-shadow: 0 0 24px rgba(255,255,255,0.35), inset 0 0 24px rgba(255,255,255,0.25);
  }
  .waves span:nth-child(2) { animation-delay: 1.05s; }
  .waves span:nth-child(3) { animation-delay: 2.1s; }
  .waves span:nth-child(4) { animation-delay: 3.15s; }
  @keyframes wave {
    0% { transform: scale(0.25); opacity: 0; }
    15% { opacity: 0.8; }
    100% { transform: scale(1); opacity: 0; }
  }


  .loc__chips { display: none; }

  /* Планшеты и телефоны: заголовок прижат к низу, плашки превращаются в чипсы, под текстом — подложка */
  @media (max-width: 1023px) {
    .loc__title {
      left: 20px !important; right: 20px; top: auto !important; bottom: 0; transform: none;
      max-width: none; padding-bottom: 28px; padding-top: 120px;
    }
    .loc__title::before {
      content: ''; position: absolute; inset: 0 -20px 0 -20px; z-index: -1;
      background: linear-gradient(to top, rgba(250,244,240,0.92) 0%, rgba(250,244,240,0.75) 55%, rgba(250,244,240,0) 100%);
    }
    .loc__title[data-theme='dark']::before {
      background: linear-gradient(to top, rgba(10,10,12,0.9) 0%, rgba(10,10,12,0.7) 55%, rgba(10,10,12,0) 100%);
    }
    .loc__h { font-size: clamp(30px, 8vw, 56px) !important; white-space: normal; line-height: 1; width: auto !important; }
    .loc__p { font-size: 15px; line-height: 1.3; width: auto !important; max-width: 560px; }
    .loc__meta { margin-bottom: 14px; }
    .loc__num { font-size: 22px; }
    .pager i { width: 7px; height: 7px; }
    .pager { gap: 12px; }
    .loc__chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 0; padding: 0; list-style: none; }
    .loc__chips li {
      font-family: var(--font-wide); font-weight: 700; font-size: 10px; letter-spacing: 0.04em; text-transform: uppercase;
      padding: 7px 10px; border-radius: 999px; background: rgba(255,255,255,0.75); color: var(--color-ink); border: 1px solid #fff;
    }
    .loc__title[data-theme='dark'] .loc__chips li { background: rgba(255,255,255,0.12); color: #fff; border-color: rgba(255,255,255,0.2); }
  }
</style>
